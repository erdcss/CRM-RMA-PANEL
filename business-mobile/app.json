{
  "expo": {
    "name": "Çalışkan Business",
    "slug": "caliskan-business",
    "version": "1.0.1",
    "orientation": "portrait",
    "scheme": "caliskanbusiness",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.caliskangroup.business",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.caliskangroup.business",
      "versionCode": 1
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#2563EB",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Çalışkan Business barkod okutmak için kameranıza erişir.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Çalışkan Business ürün görseli eklemek için fotoğraf arşivinize erişir."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "aa005486-76a0-41cd-92de-33c2070a73f1"
      }
    }
  }
}
