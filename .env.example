# Supabase Postgres connection string.
# Use the connection string shown in Supabase > Connect > ORMs / PostgreSQL.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_SUPABASE_HOST:6543/postgres

# Supabase (web + mobile)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
