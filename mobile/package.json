{
  "name": "crm-rma-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "build": "expo export --platform web",
    "start:web": "node scripts/serve-web.js",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "fix:deps": "expo install --fix",
    "build:ios": "node scripts/sync-mobile-branding.cjs b2b && node scripts/prepare-niimbot-sdk.js && eas build --platform ios --profile production",
    "submit:ios": "eas submit --platform ios --profile production --latest",
    "sync:branding": "node scripts/sync-mobile-branding.cjs b2b",
    "build:android": "node scripts/sync-mobile-branding.cjs b2b && eas build --platform android --profile production",
    "dev:live": "node scripts/live-dev.cjs --lan",
    "dev:live:tunnel": "node scripts/live-dev.cjs --tunnel",
    "dev:metro": "expo start --dev-client --lan",
    "dev:metro:tunnel": "expo start --dev-client --tunnel",
    "device:register": "eas device:create",
    "build:dev:ios": "node scripts/sync-mobile-branding.cjs b2b && eas build --platform ios --profile development-ui --clear-cache",
    "eas-build-pre-install": "node scripts/eas-preinstall.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.37",
    "expo-av": "~16.0.8",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.12",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.24",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "niimbot-printer": "file:./modules/niimbot-printer",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "latest",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "latest"
  },
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  }
}
