{
  "name": "caliskan-dukkan-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Çalışkan Dükkan Windows desktop shell",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "npm run prepare:branding && electron-builder --win nsis --x64",
    "prepare:branding": "node scripts/prepare-branding.cjs"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "com.caliskan.dukkan",
    "productName": "Çalışkan Dükkan",
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json",
      "dukkan-icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Caliskan-Dukkan-Setup-${version}.${ext}",
      "icon": "dukkan-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
