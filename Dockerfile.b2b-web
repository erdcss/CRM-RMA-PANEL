FROM node:22-bookworm-slim AS build
WORKDIR /app

COPY mobile/package.json mobile/package-lock.json ./mobile/
COPY mobile/modules ./mobile/modules

WORKDIR /app/mobile
RUN npm ci --include=dev

WORKDIR /app
COPY shared ./shared
COPY mobile ./mobile

WORKDIR /app/mobile
RUN npm run build
RUN npm prune --omit=dev

FROM node:22-bookworm-slim AS runtime
WORKDIR /app/mobile
ENV NODE_ENV=production

COPY --from=build /app/mobile/package.json ./package.json
COPY --from=build /app/mobile/node_modules ./node_modules
COPY --from=build /app/mobile/dist ./dist
COPY --from=build /app/mobile/scripts ./scripts

EXPOSE 8080
CMD ["npm", "run", "start:web"]
