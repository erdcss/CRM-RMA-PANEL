{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store"
    },
    "testflight": {
      "extends": "production",
      "autoIncrement": true,
      "distribution": "store",
      "ios": {
        "resourceClass": "m-medium"
      },
      "environment": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "U3WGSDJCT2",
        "ascAppId": "6826848065"
      }
    },
    "testflight": {
      "ios": {
        "appleTeamId": "U3WGSDJCT2",
        "ascAppId": "6826848065"
      }
    }
  }
}
